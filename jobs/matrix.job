#!/bin/bash
#SBATCH -J erf_sdm_golds_matrix
#SBATCH -N 1
#SBATCH -n 4
#SBATCH --gpus-per-task=1
#SBATCH -t 03:00:00
#SBATCH -p pbatch
#SBATCH -A asccasc
#SBATCH --exclusive
#SBATCH --export=ALL
#SBATCH -o golds_matrix_%j.out

source ~/Software/lc-env/lc_env.sh || exit 1
export OMP_NUM_THREADS=1
bash ../scripts/run_golds.sh matrix
